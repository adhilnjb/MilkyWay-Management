{
  "builds": [
    {
      "src": "project_name/wsgi.py",
      "use": "@vercel/python",
      "config": { "maxLambdaSize": "15mb", "runtime": "python3.12" }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "project_name/wsgi.py"
    }
  ],
  "scripts": {
    "build": "python build.py"
  }
}